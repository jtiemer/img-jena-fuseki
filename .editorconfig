# EditorConfig configuration for the repository
# https://editorconfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 120

[*.sh]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.tf]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[*.ini]
indent_style = space
indent_size = 4

[*.ttl]
indent_style = space
indent_size = 2
