@prefix :      <#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdb2:   <http://jena.apache.org/2016/tdb#> .
@prefix text:   <http://jena.apache.org/text#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

[] rdf:type fuseki:Server ;
   fuseki:services (
     <#service_main>
   ) .

<#service_main> rdf:type fuseki:Service ;
    fuseki:name "default" ;
    fuseki:endpoint [ fuseki:operation fuseki:query  ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ; fuseki:name "update" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r  ; fuseki:name "data"   ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ; fuseki:name "data"   ] ;
    fuseki:endpoint [ fuseki:operation fuseki:shacl  ; fuseki:name "shacl"  ] ;
    fuseki:dataset <#dataset_text> .

# text:TextDataset wraps the TDB2 store and wires the Lucene index.
<#dataset_text> rdf:type text:TextDataset ;
    text:dataset <#tdb_dataset> ;
    text:index   <#index_lucene> .

<#tdb_dataset> rdf:type tdb2:DatasetTDB2 ;
# TDB2 data location. Mounted as /fuseki/data/default
    tdb2:location "/fuseki/data/default" .

# Lucene index location. Mounted as /fuseki/data/default-lucene
<#index_lucene> rdf:type text:TextIndexLucene ;
    text:directory  "/fuseki/data/default-lucene" ;
    text:multilingualSupport true ;
    text:storeValues true ;
    text:entityMap  <#entity_map> .

<#entity_map> rdf:type text:EntityMap ;
    text:entityField  "uri"  ;
    text:defaultField "text" ;
    text:map (
      [ text:field "text" ; text:predicate rdfs:label ]
      [ text:field "text" ; text:predicate skos:prefLabel  ]
      [ text:field "text" ; text:predicate skos:altLabel  ]
      [ text:field "text_long" ; text:predicate rdfs:comment  ]
      [ text:field "text_long" ; text:predicate skos:definition  ]
    ) .
